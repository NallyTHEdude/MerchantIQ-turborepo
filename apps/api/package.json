{
    "name": "api",
    "version": "1.0.0",
    "description": "a merchant analysis api for verification and validation of the merchant based on various factors",
    "keywords": [
        "express",
        "drizzle",
        "zod",
        "postgreSQL",
        "helmet",
        "dotenv"
    ],
    "license": "ISC",
    "author": "Nawaz",
    "type": "commonjs",
    "main": "index.js",
    "scripts": {
        "dev": "concurrently --names \"API,INNGEST\" --prefix name \"npm run dev:server\" \"npm run dev:inngest\"",
        "dev:server": "tsx watch src/index.ts",
        "dev:inngest": "inngest-cli dev --sdk-url http://localhost:4000/api/inngest",
        "build": "tsc && tsc-alias",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "drizzle-kit migrate",
        "db:studio": "drizzle-kit studio",
        "test": "echo \"Error: no test specified\" && exit 1",
        "lint": "eslint . --max-warnings 0",
        "lint:fix": "eslint . --fix"
    },
    "devDependencies": {
        "@types/cors": "^2.8.19",
        "@types/node": "^26.4.1",
        "@types/pg": "^8.23.1",
        "@types/swagger-jsdoc": "^6.0.4",
        "@types/swagger-ui-express": "^4.1.8",
        "concurrently": "^10.0.5",
        "drizzle-kit": "^1.0.0-rc.4",
        "eslint": "^10.9.1",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.6",
        "inngest-cli": "^1.44.0",
        "tsc-alias": "^1.9.4",
        "tsx": "^4.23.12",
        "typescript": "6.0.2"
    },
    "dependencies": {
        "@langchain/groq": "^1.3.1",
        "@langchain/mistralai": "^1.2.0",
        "@langchain/textsplitters": "^1.0.1",
        "@types/busboy": "^1.5.4",
        "@types/express": "^5.0.6",
        "busboy": "^1.6.0",
        "cloudinary": "^2.11.0",
        "cors": "^2.8.6",
        "dotenv": "^16.0.3",
        "drizzle-orm": "^1.0.0-rc.4",
        "express": "^5.2.1",
        "express-async-handler": "^1.2.0",
        "express-validator": "^7.3.2",
        "firecrawl": "^4.37.0",
        "helmet": "^8.3.0",
        "http-status-codes": "^2.3.0",
        "inngest": "^4.20.0",
        "pdf-parse": "^2.4.5",
        "pg": "^8.23.0",
        "swagger-jsdoc": "^6.3.0",
        "swagger-model-validator": "^3.0.21",
        "swagger-ui-express": "^5.0.1",
        "zod": "^4.4.3"
    }
}
