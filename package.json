{
  "name": "merchant-analyzer-turborepo",
  "private": true,
  "scripts": {
    "ml:setup": "python -m venv apps\\ml-service\\.venv && apps\\ml-service\\.venv\\Scripts\\python.exe -m pip install -r apps\\ml-service\\requirements.txt",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "turbo": "^2.10.12",
    "typescript": "6.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "11.16.0"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}